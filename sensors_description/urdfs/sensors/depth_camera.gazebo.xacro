<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="depth_camera" params="
    name update_rate image_width image_height fov near far parent_link
    image_topic camera_info_topic depth_topic pointcloud_topic origin_xyz origin_rpy
  ">
    
    <!-- Camera Link -->
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
        <material name="Black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-05" ixy="0.0" ixz="0.0"
                 iyy="1e-05" iyz="0.0"
                 izz="1e-05"/>
      </inertial>
    </link>

    <!-- Fixed Joint to Attach the Camera to Parent Link -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
    </joint>

    <!-- Gazebo Sensor Plugin using libgazebo_ros_camera.so -->
    <gazebo reference="${name}_link">
      <sensor type="camera" name="${name}">
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <pose>${origin_xyz} ${origin_rpy}</pose>

        <camera name="${name}_camera">
          <horizontal_fov>${fov}</horizontal_fov>
          <image>
            <width>${image_width}</width>
            <height>${image_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
        </camera>

        <!-- Plugin for RGB Camera -->
        <plugin name="gazebo_ros_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/${name}</namespace>
            <remapping>~/image_raw:=${image_topic}</remapping>
            <remapping>~/camera_info:=${camera_info_topic}</remapping>
          </ros>
          <camera_name>${name}_camera</camera_name>
          <frame_name>${name}_link</frame_name>
          <update_rate>${update_rate}</update_rate>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
