<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="depth_camera" params="
    name namespace update_rate image_width image_height fov near far parent_link origin_xyz origin_rpy
  ">
    
    <!-- Camera Link -->
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
        <material name="Black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-05" ixy="0.0" ixz="0.0"
                 iyy="1e-05" iyz="0.0"
                 izz="1e-05"/>
      </inertial>
    </link>

    <!-- Fixed Joint to Parent -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
    </joint>

    <!-- Depth Camera Sensor -->
    <gazebo reference="${name}_link">
      <sensor type="depth" name="${name}">
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <pose>${origin_xyz} ${origin_rpy}</pose>

        <camera name="${name}">
          <horizontal_fov>${fov}</horizontal_fov>
          <image>
            <width>${image_width}</width>
            <height>${image_height}</height>
            <format>R8G8B8</format> <!-- RGB format -->
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
        </camera>

        <!-- Plugin for Depth Camera -->
        <plugin name="${namespace}_${name}_plugin" filename="libgazebo_ros_camera.so">
          <robotNamespace>/${namespace}</robotNamespace>
          <ros>
            <namespace>/${namespace}</namespace>

            <remapping>${name}/image_raw:=/${namespace}/${name}/image_raw</remapping>
            <remapping>${name}/image_raw/compressed:=/${namespace}/${name}/image_raw/compressed</remapping>
            <remapping>${name}/image_raw/compressedDepth:=/${namespace}/${name}/image_raw/compressedDepth</remapping>
            <remapping>${name}/image_raw/theora:=/${namespace}/${name}/image_raw/theora</remapping>

            <remapping>${name}/depth/image_raw:=/${namespace}/${name}/depth/image_raw</remapping>
            <remapping>${name}/depth/camera_info:=/${namespace}/${name}/depth/camera_info</remapping>
            <remapping>${name}/depth/image_raw/compressed:=/${namespace}/${name}/depth/image_raw/compressed</remapping>
            <remapping>${name}/depth/image_raw/compressedDepth:=/${namespace}/${name}/depth/image_raw/compressedDepth</remapping>
            <remapping>${name}/depth/image_raw/theora:=/${namespace}/${name}/depth/image_raw/theora</remapping>

            <remapping>${name}/camera_info:=/${namespace}/${name}/camera_info</remapping>
            <remapping>${name}/points:=/${namespace}/${name}/points</remapping>

          </ros>
          <camera_name>${name}</camera_name>
          <frame_name>${name}_link</frame_name>
          <update_rate>${update_rate}</update_rate>
          <point_cloud>true</point_cloud> <!-- Optional -->
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>

