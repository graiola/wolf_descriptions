<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Macro: gazebo_gps_sensor
    Description: Inserts a GPS sensor with the gazebo_ros_gps_sensor plugin.
    Parameters:
      sensor_name    - Name for the sensor element.
      namespace      - ROS namespace
      gps_topic      - Topic where GPS data will be published.
      velocity_topic - Topic where Vel data will be published.
      update_rate    - Update rate of the sensor (Hz).
      frame_id       - Frame ID to be used by the sensor.
  -->
  <xacro:macro name="gazebo_gps_sensor" params="sensor_name namespace gps_topic velocity_topic update_rate frame_id">
  
    
      <xacro:if value="${namespace == ''}">
                    <xacro:property name="frame_name_ns" value="${frame_id}"/>
      </xacro:if>
      <xacro:if value="${namespace != ''}">
                    <xacro:property name="frame_name_ns" value="${namespace+'/'+frame_id}"/>
      </xacro:if>
  
    <gazebo reference="${frame_id}">
      <sensor name="${sensor_name}" type="gps" >
        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <gps>
          <!-- Optionally, include additional sensor-specific parameters here -->
        </gps>
        <plugin name="${sensor_name}_plugin" filename="libgazebo_ros_gps_sensor.so">
          <robotNamespace>/${namespace}</robotNamespace>
          <ros>
            <namespace>/${namespace}</namespace>
            <!-- Additional ROS plugin configuration can be added here -->
            <remapping>${sensor_name}_plugin/out:=/${namespace}/${gps_topic}</remapping>
            <remapping>${sensor_name}_plugin/vel:=/${namespace}/${velocity_topic}</remapping>
          </ros>
          <frame_name>${frame_name_ns}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>

