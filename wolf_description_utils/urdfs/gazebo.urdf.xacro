<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
<xacro:arg name="period"      default="0.001"/>
<xacro:arg name="robot_name"  default=""/>
<xacro:arg name="robot_model" default=""/>
<xacro:arg name="base_name"   default="base_link"/>

<xacro:property name="model_name" value="$(arg robot_model)"/>

	<gazebo>
        <plugin name="$(arg robot_name)_controller_manager" filename="libgazebo_ros2_control.so">
                <robot_param_node>/$(arg robot_name)/robot_state_publisher</robot_param_node>
                <ros>
                        <namespace>/$(arg robot_name)</namespace>
                        <!--<remapping>tf:=$(arg robot_name)/tf</remapping>-->
                        <remapping>wolf_controller/odom:=odometry/robot</remapping>
                        <remapping>diffdrive_controller/odom:=odometry/robot</remapping>
                </ros>
                <parameters>$(find ${model_name}_description)/params/${model_name}_params_$(arg robot_name).ros2.yaml</parameters>
        </plugin>
    	<plugin name="$(arg robot_name)_ground_truth" filename="libgazebo_ros_p3d.so">
                <ros>
                    <namespace>/$(arg robot_name)</namespace>
                    <remapping>odom:=ground_truth</remapping>
                </ros>
                <frame_name>world</frame_name>
                <body_name>$(arg base_name)</body_name>
                <update_rate>${1/ $(arg period)}</update_rate>
        </plugin>
        <plugin name="$(arg robot_name)_set_joint_positions_plugin" filename="libgazebo_set_joint_positions_plugin.so">
            <robot_namespace>$(arg robot_name)</robot_namespace>
            <topic_name>set_joint_states</topic_name>
        </plugin>
	</gazebo>

</robot>

