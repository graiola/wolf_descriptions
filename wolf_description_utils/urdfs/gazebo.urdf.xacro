<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
<xacro:arg name="period"      default="0.001"/>
<xacro:arg name="robot_name"  default=""/>
<xacro:arg name="robot_model" default=""/>
<xacro:arg name="base_name"   default="base_link"/>
<xacro:arg name="sensors"     default="false"/>
<xacro:arg name="load_global_gazebo_systems" default="true"/>

<xacro:property name="model_name" value="$(arg robot_model)"/>

		<gazebo>
		        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
		                <!-- Keep ros2_control URDF source consistent with the model actually spawned by go0 -->
		                <robot_param>description</robot_param>
		                <robot_param_node>gazebo_robot_description</robot_param_node>
		                <ros>
	                        <xacro:if value="$(eval robot_name != '')">
	                                <namespace>/$(arg robot_name)</namespace>
	                        </xacro:if>
	                        <!--<remapping>tf:=$(arg robot_name)/tf</remapping>-->
	                        <remapping>wolf_controller/odom:=odometry/robot</remapping>
	                        <remapping>diffdrive_controller/odom:=odometry/robot</remapping>
	                </ros>
                <parameters>$(find ${model_name}_description)/params/${model_name}_params_$(arg robot_name).ros2.yaml</parameters>
        </plugin>
        <xacro:if value="$(arg load_global_gazebo_systems)">
                <!-- Gazebo Sim sensor systems are global to the running world.
                     Loading them once avoids multi-robot duplicate visual/rendering crashes. -->
                <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>
                <xacro:if value="$(arg sensors)">
                        <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
                                <render_engine>ogre2</render_engine>
                        </plugin>
                        <plugin filename="ignition-gazebo-navsat-system" name="ignition::gazebo::systems::NavSat"/>
                </xacro:if>
        </xacro:if>
	</gazebo>

</robot>
