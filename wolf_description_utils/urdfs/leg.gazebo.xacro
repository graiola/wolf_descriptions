<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="leg_gazebo" params="prefix robot_name load_force_sensors">

    <!-- Joint feedback -->
    <gazebo reference="${prefix}_haa_joint">
      <provideFeedback>true</provideFeedback>
    </gazebo>
    <gazebo reference="${prefix}_hfe_joint">
      <provideFeedback>true</provideFeedback>
    </gazebo>
    <gazebo reference="${prefix}_kfe_joint">
      <provideFeedback>true</provideFeedback>
    </gazebo>

    <!-- Joint controller plugins for Ignition -->
    <gazebo>
      <plugin name="ignition::gazebo::systems::JointPositionController" filename="libignition-gazebo-joint-position-controller-system.so">
        <joint_name>${prefix}_haa_joint</joint_name>
        <joint_name>${prefix}_hfe_joint</joint_name>
        <joint_name>${prefix}_kfe_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- Fixed joint handling -->
    <gazebo reference="${prefix}_foot_joint">
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>

    <!-- Visual/collision and contact sensors -->
    <gazebo reference="${prefix}_upperleg">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <fdir1>1 0 0</fdir1>
      <maxVel>1.0</maxVel>
      <maxContacts>1</maxContacts>
      <minDepth>0.00</minDepth>
    </gazebo>

    <gazebo reference="${prefix}_lowerleg">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <maxVel>1.0</maxVel>
      <maxContacts>1</maxContacts>
      <sensor name="${prefix}_shin_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>250.0</update_rate>
        <contact>
          <collision>${prefix}_lowerleg_collision</collision>
        </contact>
        <plugin name="ignition::gazebo::systems::Contact" filename="libignition-gazebo-contact-system.so">
          <topic>/${robot_name}/${prefix}_shin_bumper</topic>
          <frame_name>${prefix}_lowerleg</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}_foot">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <maxVel>1.0</maxVel>
      <maxContacts>1</maxContacts>
      <sensor name="${prefix}_foot_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>250.0</update_rate>
        <contact>
          <collision>${prefix}_foot_collision</collision>
        </contact>
        <plugin name="ignition::gazebo::systems::Contact" filename="libignition-gazebo-contact-system.so">
          <topic>/${robot_name}/${prefix}_foot_bumper</topic>
          <frame_name>${prefix}_foot</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
