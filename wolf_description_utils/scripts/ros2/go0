def initialize_node(args):
    rclpy.init(args=args)
    return rclpy.create_node('goto0',
                              allow_undeclared_parameters=False,
                              automatically_declare_parameters_from_overrides=True)


def get_param(node, param_name):
    return node.get_parameter(param_name).value


def wait_for_service(node, service_name):
    client = node.create_client(Empty, service_name)
    while not client.wait_for_service(timeout_sec=1.0):
        node.get_logger().info(f'Waiting for {service_name} service...')
    return client


def call_service(client, node):
    request = Empty.Request()
    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future)
    if future.result() is not None:
        node.get_logger().info(f'Service call to {client.srv_name} succeeded.')
    else:
        node.get_logger().error(f'Service call to {client.srv_name} failed.')


def calculate_quaternion(roll, pitch, yaw):
    qx = math.sin(roll / 2.0) * math.cos(pitch / 2.0) * math.cos(yaw / 2.0) - math.cos(roll / 2.0) * math.sin(pitch / 2.0) * math.sin(yaw / 2.0)
    qy = math.cos(roll / 2.0) * math.sin(pitch / 2.0) * math.cos(yaw / 2.0) + math.sin(roll / 2.0) * math.cos(pitch / 2.0) * math.sin(yaw / 2.0)
    qz = math.cos(roll / 2.0) * math.cos(pitch / 2.0) * math.sin(yaw / 2.0) - math.sin(roll / 2.0) * math.sin(pitch / 2.0) * math.cos(yaw / 2.0)
    qw = math.cos(roll / 2.0) * math.cos(pitch / 2.0) * math.cos(yaw / 2.0) + math.sin(roll / 2.0) * math.sin(pitch / 2.0) * math.sin(yaw / 2.0)
    return qx, qy, qz, qw


def pause_physics(node, gazebo_namespace):
    service_name = f"{gazebo_namespace}/pause_physics"
    client = wait_for_service(node, service_name)
    call_service(client, node)
    node.get_logger().info("Paused Gazebo physics.")


def unpause_physics(node, gazebo_namespace):
    service_name = f"{gazebo_namespace}/unpause_physics"
    client = wait_for_service(node, service_name)
    call_service(client, node)
    node.get_logger().info("Unpaused Gazebo physics.")


def get_parameter_from_remote_node(node, param_path, timeout=10.0):
    split_path = param_path.strip('/').split('/')
    if len(split_path) < 2:
        node.get_logger().error(f"Invalid parameter path format: {param_path}. Expected format: '/namespace/node/param'")
        return None
    
    param_name = split_path[-1]
    remote_node_name = split_path[-2]
    namespace = '/'.join(split_path[:-2]) if len(split_path) > 2 else ''
    full_node_path = f"/{namespace}/{remote_node_name}" if namespace else f"/{remote_node_name}"

    client = node.create_client(GetParameters, f'{full_node_path}/get_parameters')
    if not client.wait_for_service(timeout_sec=timeout):
        node.get_logger().error(f"Service {full_node_path}/get_parameters not available!")
        return None

    request = GetParameters.Request()
    request.names = [param_name]
    return client.call_async(request)


def convert_urdf_to_sdf(urdf_str):
    try:
        proc = subprocess.run(['gz', 'sdf', '-p'], input=urdf_str.encode(), capture_output=True)
        if proc.returncode == 0:
            return proc.stdout.decode()
        else:
            print("[ERROR] gz sdf stderr:", proc.stderr.decode())  # <--- ADD THIS
            raise RuntimeError(f"URDF to SDF conversion failed:\n{proc.stderr.decode()}")
    except FileNotFoundError:
        raise RuntimeError("The `gz` command is not found. Make sure Gazebo is installed and `gz` is in your PATH.")


def spawn_model(node, robot_name, model_xml, initial_pose, reference_frame, gazebo_namespace):
    client = node.create_client(SpawnEntity, gazebo_namespace + '/spawn_entity')
    client.wait_for_service()
    request = SpawnEntity.Request()
    request.name = robot_name
    request.xml = xml_utils.unescape(model_xml)
    request.robot_namespace = robot_name
    request.initial_pose = initial_pose
    request.reference_frame = reference_frame

    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future)
    if future.result() is not None:
        node.get_logger().info(f"Successfully spawned: {robot_name}")
    else:
        node.get_logger().error(f"Failed to spawn: {robot_name}")


def spawn_model_cli_from_xml(robot_name, model_xml, initial_pose, robot_namespace):
    if not robot_name:
        raise ValueError("robot_name is empty!")

    if not model_xml.strip():
        raise ValueError("model_xml is empty!")

    suffix = '.sdf' if model_xml.strip().startswith('<sdf') else '.urdf'
    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix=suffix) as f:
        f.write(model_xml)
        tmpfile = f.name

    format_flag = '-sdf' if suffix == '.sdf' else ''

    cmd = [
        'ros2', 'run', 'gazebo_ros', 'spawn_entity.py',
        '-file', tmpfile,
        '-entity', robot_name,
        '-robot_namespace', robot_namespace,
        '-reference_frame', 'world',
        '-x', str(initial_pose.position.x),
        '-y', str(initial_pose.position.y),
        '-z', str(initial_pose.position.z),
        '-R', '0',
        '-P', '0',
        '-Y', '0'
    ]

    if format_flag:
        cmd.append(format_flag)

    print("[DEBUG] Running command:")
    print(" ".join(cmd))

    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        print(f"[ERROR] Failed to spawn with spawn_entity.py: {e}")
    finally:
        os.remove(tmpfile)


def spawn_model_with_gz_model(robot_name, model_sdf, initial_pose):
    tmpfile_path = f"/tmp/{robot_name}.sdf"
    with open(tmpfile_path, 'w') as f:
        f.write(model_sdf)

    cmd = [
        'gz', 'model',
        '--spawn-file', tmpfile_path,
        '--model-name', robot_name,
        '-x', str(initial_pose.position.x),
        '-y', str(initial_pose.position.y),
        '-z', str(initial_pose.position.z),
        '-Y', str(initial_pose.orientation.z)  # Yaw approximation
    ]

    print("[DEBUG] Running command:")
    print(" ".join(cmd))

    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        print(f"[ERROR] Failed to spawn model using gz model: {e}")


def set_joint_positions_with_plugin(node, joint_names, joint_positions, robot_name):
    topic_name = f"/{robot_name}/set_joint_states" if robot_name else "/set_joint_states"

    qos_profile = QoSProfile(
        depth=10,
        durability=DurabilityPolicy.TRANSIENT_LOCAL,
        history=HistoryPolicy.KEEP_LAST
    )
    
    publisher = node.create_publisher(JointState, topic_name, qos_profile)
    node.get_logger().info(f"Created publisher on {topic_name}")
    
    while publisher.get_subscription_count() == 0:
        node.get_logger().info("Waiting for a subscriber to connect...")
        rclpy.spin_once(node, timeout_sec=0.5)
    
    joint_state_msg = JointState()
    joint_state_msg.header.stamp = node.get_clock().now().to_msg()
    joint_state_msg.header.frame_id = 'world'
    joint_state_msg.name = joint_names
    joint_state_msg.position = joint_positions
    joint_state_msg.velocity = [0.0] * len(joint_positions)
    joint_state_msg.effort = [0.0] * len(joint_positions)

    publisher.publish(joint_state_msg)
    node.get_logger().info(f"Published joint positions for {len(joint_names)} joints.")


def main(args=None):
    node = initialize_node(args)
    gazebo_namespace = ""

    model_name = get_param(node, 'robot_model')
    robot_name = get_param(node, 'robot_name')
    robot_description_name = get_param(node, 'description')
    robot_description_semantic_name = get_param(node, 'semantic_description')
    initial_xyz = get_param(node, 'initial_xyz')
    initial_rpy = get_param(node, 'initial_rpy')

    if not robot_name:
        node.get_logger().warn("robot_name is empty. Falling back to model_name.")
        robot_name = model_name

    model_xml_future = get_parameter_from_remote_node(node, f'/{robot_description_name}')
