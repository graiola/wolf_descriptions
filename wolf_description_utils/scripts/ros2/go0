    rclpy.spin_until_future_complete(node, srdf_data_future)

    model_xml = model_xml_future.result().values[0].string_value if model_xml_future.result() else None
    srdf_data = srdf_data_future.result().values[0].string_value if srdf_data_future.result() else None

    if not model_xml or not srdf_data:
        node.get_logger().error(f"Model or SRDF data unavailable for {robot_name}")
        sys.exit(1)

    initial_pose = Pose()
    initial_pose.position.x = float(initial_xyz[0])
    initial_pose.position.y = float(initial_xyz[1])
    initial_pose.position.z = float(initial_xyz[2])
    qx, qy, qz, qw = calculate_quaternion(*[float(x) for x in initial_rpy])
    initial_pose.orientation.x = qx
    initial_pose.orientation.y = qy
    initial_pose.orientation.z = qz
    initial_pose.orientation.w = qw

    pause_physics(node, gazebo_namespace)

    ### --- Choose one method below ---

    spawn_model(node, robot_name, model_xml, initial_pose, "world", gazebo_namespace)

    # spawn_model_cli_from_xml(robot_name, model_xml, initial_pose, robot_name)

