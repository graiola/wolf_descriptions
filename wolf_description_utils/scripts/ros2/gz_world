#!/usr/bin/env python3

import os
import shutil
import sys

import rclpy
from ament_index_python.packages import (
    PackageNotFoundError,
    get_package_prefix,
    get_package_share_directory,
)


def _prepend_env_path(var_name, path):
    if not path or not os.path.exists(path):
        return
    current = os.environ.get(var_name, "")
    if current:
        os.environ[var_name] = f"{path}:{current}"
    else:
        os.environ[var_name] = path


def _maybe_prepend_pkg_lib(pkg_name):
    try:
        prefix = get_package_prefix(pkg_name)
    except PackageNotFoundError:
        return
    _prepend_env_path("GZ_SIM_SYSTEM_PLUGIN_PATH", os.path.join(prefix, "lib"))


def _parse_bool(value, default=False):
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, str):
        return value.strip().lower() in ("1", "true", "yes", "on")
    return bool(value)


def main(args=None):
    rclpy.init(args=args)
    node = rclpy.create_node(
        "gz_world",
        allow_undeclared_parameters=False,
        automatically_declare_parameters_from_overrides=True,
    )

    world_file = node.get_parameter("world_file").value
    paused = _parse_bool(node.get_parameter("paused").value, default=False)
    gui = _parse_bool(node.get_parameter("gui").value, default=True)
    headless = _parse_bool(node.get_parameter("headless").value, default=False)
    debug = _parse_bool(node.get_parameter("debug").value, default=False)
    simulator = str(node.get_parameter("simulator").value or "").strip().lower()

    if not world_file:
        node.get_logger().error("Missing 'world_file' parameter")
        rclpy.shutdown()
        sys.exit(1)

    if not os.path.exists(world_file):
        node.get_logger().error(f"World file does not exist: {world_file}")
        rclpy.shutdown()
        sys.exit(1)

    if simulator and simulator not in ("gz", "gazebo", "gazebo_sim", "gazebo-sim"):
        node.get_logger().warn(
            f"Requested simulator '{simulator}' is no longer supported on the active ROS2 branch. Using gz sim."
        )

    if not shutil.which("gz"):
        node.get_logger().error("The 'gz' command is not available in the environment.")
        rclpy.shutdown()
        sys.exit(1)

    resources_share = get_package_share_directory("wolf_gazebo_resources")
    worlds_path = os.path.join(resources_share, "worlds")
    models_path = os.path.join(resources_share, "models")
    _prepend_env_path("GZ_SIM_RESOURCE_PATH", worlds_path)
    _prepend_env_path("GZ_SIM_RESOURCE_PATH", models_path)
    _maybe_prepend_pkg_lib("gz_ros2_control")
    _maybe_prepend_pkg_lib("wolf_description_utils")

    cmd = ["gz", "sim"]
    if headless or not gui:
        cmd.append("-s")
    if not paused:
        cmd.append("-r")
    if debug:
        cmd.extend(["-v", "4"])
    cmd.append(world_file)

    node.get_logger().info("Launching Gazebo Sim via gz: %s" % " ".join(cmd))
    node.destroy_node()
    rclpy.shutdown()
    os.execvpe(cmd[0], cmd, os.environ.copy())


if __name__ == "__main__":
    main()
