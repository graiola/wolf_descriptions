#!/usr/bin/env python3

import os
import shutil
import sys
import tempfile
import xml.etree.ElementTree as ET

import rclpy
from ament_index_python.packages import (
    PackageNotFoundError,
    get_package_prefix,
    get_package_share_directory,
)


def _prepend_env_path(var_name, path):
    if not path or not os.path.exists(path):
        return
    current = os.environ.get(var_name, "")
    if current:
        os.environ[var_name] = f"{path}:{current}"
    else:
        os.environ[var_name] = path


def _maybe_prepend_pkg_lib(pkg_name):
    try:
        prefix = get_package_prefix(pkg_name)
    except PackageNotFoundError:
        return
    _prepend_env_path("GZ_SIM_SYSTEM_PLUGIN_PATH", os.path.join(prefix, "lib"))


def _parse_bool(value, default=False):
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    if isinstance(value, str):
        return value.strip().lower() in ("1", "true", "yes", "on")
    return bool(value)


def _ensure_world_plugin(world_file, plugin_name, plugin_filename):
    tree = ET.parse(world_file)
    root = tree.getroot()
    world = root.find("world")
    if world is None:
        return world_file, False

    for plugin in world.findall("plugin"):
        if plugin.get("name") == plugin_name:
            return world_file, False

    plugin = ET.Element("plugin")
    plugin.set("filename", plugin_filename)
    plugin.set("name", plugin_name)
    world.insert(0, plugin)

    fd, patched_world = tempfile.mkstemp(prefix="wolf_gz_world_", suffix=".world")
    os.close(fd)
    tree.write(patched_world, encoding="utf-8", xml_declaration=True)
    return patched_world, True


def main(args=None):
    rclpy.init(args=args)
    node = rclpy.create_node(
        "gz_world",
        allow_undeclared_parameters=False,
        automatically_declare_parameters_from_overrides=True,
    )

    world_file = node.get_parameter("world_file").value
    paused = _parse_bool(node.get_parameter("paused").value, default=False)
    gui = _parse_bool(node.get_parameter("gui").value, default=True)
    headless = _parse_bool(node.get_parameter("headless").value, default=False)
    debug = _parse_bool(node.get_parameter("debug").value, default=False)
    simulator = str(node.get_parameter("simulator").value or "").strip().lower()

    if not world_file:
        node.get_logger().error("Missing 'world_file' parameter")
        rclpy.shutdown()
        sys.exit(1)

    if not os.path.exists(world_file):
        node.get_logger().error(f"World file does not exist: {world_file}")
        rclpy.shutdown()
        sys.exit(1)

    if simulator and simulator not in ("gz", "gazebo", "gazebo_sim", "gazebo-sim"):
        node.get_logger().warn(
            f"Requested simulator '{simulator}' is no longer supported on the active ROS2 branch. Using gz sim."
        )

    if not shutil.which("gz"):
        node.get_logger().error("The 'gz' command is not available in the environment.")
        rclpy.shutdown()
        sys.exit(1)

    resources_share = get_package_share_directory("wolf_gazebo_resources")
    worlds_path = os.path.join(resources_share, "worlds")
    models_path = os.path.join(resources_share, "models")
    _prepend_env_path("GZ_SIM_RESOURCE_PATH", worlds_path)
    _prepend_env_path("GZ_SIM_RESOURCE_PATH", models_path)
    _maybe_prepend_pkg_lib("gz_ros2_control")
    _maybe_prepend_pkg_lib("wolf_description_utils")

    world_file_to_launch, injected_physics_plugin = _ensure_world_plugin(
        world_file,
        "gz::sim::systems::Physics",
        "ignition-gazebo-physics-system",
    )
    world_file_to_launch, injected_scene_plugin = _ensure_world_plugin(
        world_file_to_launch,
        "gz::sim::systems::SceneBroadcaster",
        "ignition-gazebo-scene-broadcaster-system",
    )
    world_file_to_launch, injected_user_commands_plugin = _ensure_world_plugin(
        world_file_to_launch,
        "gz::sim::systems::UserCommands",
        "ignition-gazebo-user-commands-system",
    )
    world_file_to_launch, injected_sensors_plugin = _ensure_world_plugin(
        world_file_to_launch,
        "gz::sim::systems::Sensors",
        "gz-sim-sensors-system",
    )
    if injected_sensors_plugin:
        tree = ET.parse(world_file_to_launch)
        root = tree.getroot()
        world = root.find("world")
        if world is not None:
            for plugin in world.findall("plugin"):
                if plugin.get("name") == "gz::sim::systems::Sensors" and plugin.find("render_engine") is None:
                    render_engine = ET.Element("render_engine")
                    render_engine.text = "ogre2"
                    plugin.append(render_engine)
                    tree.write(world_file_to_launch, encoding="utf-8", xml_declaration=True)
                    break

    world_file_to_launch, injected_imu_plugin = _ensure_world_plugin(
        world_file_to_launch,
        "gz::sim::systems::Imu",
        "gz-sim-imu-system",
    )
    world_file_to_launch, injected_navsat_plugin = _ensure_world_plugin(
        world_file_to_launch,
        "gz::sim::systems::NavSat",
        "gz-sim-navsat-system",
    )
    if (
        injected_physics_plugin
        or injected_scene_plugin
        or injected_user_commands_plugin
        or injected_sensors_plugin
        or injected_imu_plugin
        or injected_navsat_plugin
    ):
        node.get_logger().info(
            "Injected missing global Gazebo world systems into world file before launch."
        )

    cmd = ["gz", "sim"]
    if headless or not gui:
        cmd.append("-s")
    if not paused:
        cmd.append("-r")
    if debug:
        cmd.extend(["-v", "4"])
    cmd.append(world_file_to_launch)

    node.get_logger().info("Launching Gazebo Sim via gz: %s" % " ".join(cmd))
    node.destroy_node()
    rclpy.shutdown()
    os.execvpe(cmd[0], cmd, os.environ.copy())


if __name__ == "__main__":
    main()
