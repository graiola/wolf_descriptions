<?xml version="1.0"?>
<launch>

    <!-- These are the arguments you can pass this launch file, for example paused:=true -->
    <arg name="sensors" default="false"/>
    <arg name="robot_model" default="spot"/>
    <arg name="robot_name" default=""/>
    <arg name="paused" default="false"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="gui" default="true"/>
    <arg name="headless" default="false"/>
    <arg name="debug" default="false"/>
    <arg name="launch_world" default="true"/>
    <arg name="world_name" default="empty"/>
    <arg name="period" default="0.001"/>
    <arg name="arm_name" default=""/>
    <arg name="engine" default="ode"/>
    <arg name="simulator" default="ignition"/>
    <arg name="load_global_gazebo_systems" default="true"/>
    <arg name="world_file" default="$(find-pkg-share wolf_gazebo_resources)/worlds/$(var world_name).world"/>
    <arg name="bridge_imu" default="true" description="bridge Gazebo IMU topic to ROS 2"/>
    <arg name="bridge_clock" default="true" description="bridge Gazebo clock topic to ROS 2"/>
    <arg name="bridge_camera" default="true" description="bridge Gazebo camera topics to ROS 2"/>
    <arg name="bridge_lidar" default="true" description="bridge Gazebo lidar topic to ROS 2"/>
    <arg name="bridge_gps" default="true" description="bridge Gazebo GPS topic to ROS 2"/>
    
    <group if="$(var launch_world)">
        <node pkg="wolf_description_utils" exec="ignition_world" name="ignition_world" output="screen">
            <param name="world_file" value="$(var world_file)"/>
            <param name="paused" value="$(var paused)"/>
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <param name="gui" value="$(var gui)"/>
            <param name="headless" value="$(var headless)"/>
            <param name="debug" value="$(var debug)"/>
            <param name="engine" value="$(var engine)"/>
        </node>
    </group>

    <!-- Send the robot urdf to parameter server -->
    <include file="$(find-pkg-share wolf_description_utils)/launch/upload.launch.xml">
        <arg name="sensors" value="$(var sensors)"/>
        <arg name="period" value="$(var period)"/>
        <arg name="robot_model" value="$(var robot_model)"/>
        <arg name="arm_name" value="$(var arm_name)"/>
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="simulator" value="$(var simulator)"/>
        <arg name="load_global_gazebo_systems" value="$(var load_global_gazebo_systems)"/>
    </include>

    <group if="$(var bridge_clock)">
        <group if="$(var use_sim_time)">
            <node pkg="ros_gz_bridge" exec="parameter_bridge" name="clock_bridge" output="screen"
                  args="/clock@rosgraph_msgs/msg/Clock[ignition.msgs.Clock"/>
        </group>
    </group>

    <group if="$(var bridge_imu)">
        <group if="$(eval '\'$(var robot_name)\' == \'\'')">
            <node pkg="ros_gz_bridge" exec="parameter_bridge" name="imu_bridge" output="screen"
                  args="/trunk_imu/data@sensor_msgs/msg/Imu[ignition.msgs.IMU"/>
        </group>
        <group if="$(eval '\'$(var robot_name)\' != \'\'')">
            <node pkg="ros_gz_bridge" exec="parameter_bridge" name="imu_bridge" output="screen"
                  args="/$(var robot_name)/trunk_imu/data@sensor_msgs/msg/Imu[ignition.msgs.IMU"/>
        </group>
    </group>

    <group if="$(var sensors)">
        <group if="$(var bridge_camera)">
            <group if="$(eval '\'$(var robot_name)\' == \'\'')">
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_bridge" output="screen"
                      args="/camera/image@sensor_msgs/msg/Image[ignition.msgs.Image">
                    <remap from="/camera/image" to="/camera/image_raw"/>
                </node>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_info_bridge" output="screen"
                      args="/camera/camera_info@sensor_msgs/msg/CameraInfo[ignition.msgs.CameraInfo"/>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_depth_bridge" output="screen"
                      args="/camera/depth_image@sensor_msgs/msg/Image[ignition.msgs.Image">
                    <remap from="/camera/depth_image" to="/camera/depth/image_raw"/>
                </node>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_points_bridge" output="screen"
                      args="/camera/points@sensor_msgs/msg/PointCloud2[ignition.msgs.PointCloudPacked"/>
            </group>
            <group if="$(eval '\'$(var robot_name)\' != \'\'')">
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_bridge" output="screen"
                      args="/$(var robot_name)/camera/image@sensor_msgs/msg/Image[ignition.msgs.Image">
                    <remap from="/$(var robot_name)/camera/image" to="/$(var robot_name)/camera/image_raw"/>
                </node>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_info_bridge" output="screen"
                      args="/$(var robot_name)/camera/camera_info@sensor_msgs/msg/CameraInfo[ignition.msgs.CameraInfo"/>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_depth_bridge" output="screen"
                      args="/$(var robot_name)/camera/depth_image@sensor_msgs/msg/Image[ignition.msgs.Image">
                    <remap from="/$(var robot_name)/camera/depth_image" to="/$(var robot_name)/camera/depth/image_raw"/>
                </node>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="camera_points_bridge" output="screen"
                      args="/$(var robot_name)/camera/points@sensor_msgs/msg/PointCloud2[ignition.msgs.PointCloudPacked"/>
            </group>
        </group>

        <group if="$(var bridge_lidar)">
            <group if="$(eval '\'$(var robot_name)\' == \'\'')">
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="lidar_scan_bridge" output="screen"
                      args="/lidar_points@sensor_msgs/msg/LaserScan[ignition.msgs.LaserScan">
                    <remap from="/lidar_points" to="/lidar_scan"/>
                </node>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="lidar_points_bridge" output="screen"
                      args="/lidar_points/points@sensor_msgs/msg/PointCloud2[ignition.msgs.PointCloudPacked">
                    <remap from="/lidar_points/points" to="/lidar_points"/>
                </node>
            </group>
            <group if="$(eval '\'$(var robot_name)\' != \'\'')">
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="lidar_scan_bridge" output="screen"
                      args="/$(var robot_name)/lidar_points@sensor_msgs/msg/LaserScan[ignition.msgs.LaserScan">
                    <remap from="/$(var robot_name)/lidar_points" to="/$(var robot_name)/lidar_scan"/>
                </node>
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="lidar_points_bridge" output="screen"
                      args="/$(var robot_name)/lidar_points/points@sensor_msgs/msg/PointCloud2[ignition.msgs.PointCloudPacked">
                    <remap from="/$(var robot_name)/lidar_points/points" to="/$(var robot_name)/lidar_points"/>
                </node>
            </group>
        </group>

        <group if="$(var bridge_gps)">
            <group if="$(eval '\'$(var robot_name)\' == \'\'')">
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gps_bridge" output="screen"
                      args="/gps/fix@sensor_msgs/msg/NavSatFix[ignition.msgs.NavSat"/>
            </group>
            <group if="$(eval '\'$(var robot_name)\' != \'\'')">
                <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gps_bridge" output="screen"
                      args="/$(var robot_name)/gps/fix@sensor_msgs/msg/NavSatFix[ignition.msgs.NavSat"/>
            </group>
        </group>
    </group>

</launch>
