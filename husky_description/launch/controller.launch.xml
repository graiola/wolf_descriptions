<?xml version="1.0" ?>
<launch>

    <!-- Robot related arguments -->
    <arg name="robot_model"        default="husky"/>
    <arg name="robot_name"         default=""       description="robot namespace"/>
    <arg name="sensors"            default="false"  description="activate robot's sensors"/>
    <arg name="period"             default="0.001"  description="controller period"/>
    <arg name="arm_name"           default=""       description="[kinova]"/>
    <arg name="max_vel_x"          default="1.0"    description="maximum linear velocity x m/s" />
    <arg name="max_vel_y"          default="0.0"    description="unused compatibility argument" />
    <arg name="max_vel_z"          default="0.0"    description="unused compatibility argument" />
    <arg name="max_vel_yaw"        default="1.7"    description="maximum angular velocity yaw rad/s"/>

    <!-- Input device argument -->
    <arg name="input_device"       default="keyboard" description="unused compatibility argument"/>

    <!-- Gazebo related arguments -->
    <arg name="gazebo"        default="true"     description="start gazebo"/>
    <arg name="gazebo_debug"  default="false"    description="activate gazebo debug"/>
    <arg name="engine"        default="ode"      description="[ode/bullet/dart/simbody]"/>
    <arg name="spawn_robot"   default="true"     description="spawn the robot in gazebo"/>
    <arg name="initial_xyz"   default="[0,0,0]"  description="initial robot xyz position in the world"/>
    <arg name="initial_rpy"   default="[0,0,0]"  description="initial robot rpy position in the world"/>
    <arg name="world_name"    default="empty"    description="load a specific world from wolf_gazebo_resources"/>
    <arg name="world_file"    default="$(find-pkg-share wolf_gazebo_resources)/worlds/$(var world_name).world" description="load a specific world file"/>
    <arg name="simulator"     default="gz"       description="Gazebo CLI family to use for world interaction"/>
    <arg name="load_global_gazebo_systems" default="true" description="load Gazebo Sim global sensor systems for this robot"/>

    <!-- GUI related arguments -->
    <arg name="gazebo_gui"      default="true"  description="start gzclient"/>
    <arg name="plotjuggler_gui" default="false" description="start plotjuggler"/>
    <arg name="rviz_gui"        default="false" description="start rviz"/>
    <arg name="rqt_gui"         default="false" description="unused compatibility argument"/>
    <arg name="plot_node_gui"   default="false" description="unused compatibility argument"/>
    <arg name="full_gui"        default="false" description="unused compatibility argument"/>

    <!-- Odometry arguments -->
    <arg name="publish_odom_msg" default="true" description="publish nav_msgs/Odometry message from the controller"/>
    <arg name="publish_odom_tf"  default="true" description="publish the odom tf frame from the controller"/>
    <arg name="controller_params_file" default="/tmp/wolf_controller_params/$(var robot_model)_params_$(var robot_name).ros2.yaml" description="shared resolved ROS2 controller params file"/>

    <!-- Planner arguments -->
    <arg name="launch_planner" default="false" description="unused compatibility argument"/>

    <!-- 'use_sim_time' will be set on all nodes following the line below -->
    <set_parameter name="use_sim_time" value="true"/> <!-- FIXME it should be conditional! -->

    <executable cmd="python3 $(find-pkg-share wolf_controller_utils)/replace_yaml_placeholders.py 
        $(find-pkg-share $(var robot_model)_description)/params/$(var robot_model)_params.ros2.yaml
        $(var controller_params_file)
        PERIOD=$(var period)
        MAX_VEL_X=$(var max_vel_x)
        MAX_VEL_YAW=$(var max_vel_yaw)
        PUBLISH_ODOM_MSG=$(var publish_odom_msg)
        PUBLISH_ODOM_TF=$(var publish_odom_tf)
        TF_PREFIX=$(var robot_name)"/>

    <executable cmd="python3 $(find-pkg-share wolf_controller_utils)/replace_yaml_placeholders.py 
        $(find-pkg-share husky_description)/params/twist_mux.yaml
        $(find-pkg-share husky_description)/params/twist_mux_$(var robot_name).yaml
        TF_PREFIX=$(var robot_name)"/>

    <timer period="20.0">
    <group>
    <push-ros-namespace namespace="$(var robot_name)"/>

        <!-- Load the robot description and Gazebo -->
        <group if="$(var gazebo)">
            <include file="$(find-pkg-share wolf_description_utils)/launch/world.launch.xml">
                <arg name="sensors"           value="$(var sensors)" />
                <arg name="robot_model"       value="$(var robot_model)" />
                <arg name="robot_name"        value="$(var robot_name)" />
                <arg name="world_name"        value="$(var world_name)" />
                <arg name="world_file"        value="$(var world_file)" />
                <arg name="simulator"         value="$(var simulator)" />
                <arg name="period"            value="$(var period)" />
                <arg name="gui"               value="$(var gazebo_gui)"/>
                <arg name="arm_name"          value="$(var arm_name)"/>
                <arg name="debug"             value="$(var gazebo_debug)"/>
                <arg name="engine"            value="$(var engine)"/>
                <arg name="load_global_gazebo_systems" value="$(var load_global_gazebo_systems)"/>
                <arg name="controller_params_file" value="$(var controller_params_file)"/>
            </include>
        </group>
        <group unless="$(var gazebo)">
            <include file="$(find-pkg-share wolf_description_utils)/launch/world.launch.xml">
                <arg name="launch_world"      value="false"/>
                <arg name="bridge_clock"      value="false"/>
                <arg name="sensors"           value="$(var sensors)" />
                <arg name="robot_model"       value="$(var robot_model)" />
                <arg name="robot_name"        value="$(var robot_name)" />
                <arg name="world_name"        value="$(var world_name)" />
                <arg name="world_file"        value="$(var world_file)" />
                <arg name="period"            value="$(var period)" />
                <arg name="gui"               value="$(var gazebo_gui)"/>
                <arg name="arm_name"          value="$(var arm_name)"/>
                <arg name="debug"             value="$(var gazebo_debug)"/>
                <arg name="engine"            value="$(var engine)"/>
                <arg name="load_global_gazebo_systems" value="$(var load_global_gazebo_systems)"/>
                <arg name="controller_params_file" value="$(var controller_params_file)"/>
            </include>
        </group>

        <!-- Spawn the robot in Gazebo -->
        <node pkg="wolf_description_utils" exec="go0" name="spawn_robot" output="screen" if="$(var spawn_robot)">
            <param name="robot_model"              value="$(var robot_model)"/>
            <param name="robot_name"               value="$(var robot_name)"/>
            <param name="description"              value="$(var robot_name)/gazebo_robot_description/description"/>
            <param name="semantic_description"     value="$(var robot_name)/robot_description_semantic/description"/>
            <param name="initial_xyz"              value="$(var initial_xyz)"/>
            <param name="initial_rpy"              value="$(var initial_rpy)"/>
            <param name="world_file"               value="$(var world_file)"/>
            <param name="simulator"                value="$(var simulator)"/>
        </node>

        <!-- Convert joint states to TF transforms for rviz, etc -->
        <group if="$(eval '\'$(var robot_name)\' == \'\'')">
            <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher" respawn="false" output="log">
                <remap from="/joint_states"     to="/joint_states"/>
                <param name="frame_prefix"      value=""/>
                <param name="robot_description" value="$(command 'xacro $(find-pkg-share $(var robot_model)_description)/robots/$(var robot_model).urdf.xacro 
                sensors:=$(var sensors) period:=$(var period) arm_name:=$(var arm_name) simulator:=$(var simulator) controller_params_file:=$(var controller_params_file)')"/>
            </node>
        </group>
        <group if="$(eval '\'$(var robot_name)\' != \'\'')">
            <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher" respawn="false" output="log">
                <remap from="/joint_states"     to="$(var robot_name)/joint_states"/>
                <param name="frame_prefix"      value="$(var robot_name)/"/>
                <param name="robot_description" value="$(command 'xacro $(find-pkg-share $(var robot_model)_description)/robots/$(var robot_model).urdf.xacro 
                sensors:=$(var sensors) period:=$(var period) arm_name:=$(var arm_name) robot_name:=$(var robot_name) simulator:=$(var simulator) controller_params_file:=$(var controller_params_file)')"/>
            </node>
        </group>

        <!-- Spawn the controller and joint state broadcaster -->
        <group if="$(eval '\'$(var robot_name)\' == \'\'')">
            <node pkg="controller_manager" exec="spawner"
                name="joint_state_broadcaster_spawner" output="screen"
                args="joint_state_broadcaster
                        -c /controller_manager
                        --controller-manager-timeout 120.0
                        --switch-timeout 120.0
                        --service-call-timeout 30.0"/>

            <timer period="4.0">
            <node pkg="controller_manager" exec="spawner"
                    name="diffdrive_controller_spawner" output="screen"
                    args="diffdrive_controller 
                        -c /controller_manager
                        --controller-manager-timeout 120.0
                        --switch-timeout 120.0
                        --service-call-timeout 30.0"/>
            </timer>
        </group>

        <group if="$(eval '\'$(var robot_name)\' != \'\'')">
            <node pkg="controller_manager" exec="spawner"
                name="joint_state_broadcaster_spawner" output="screen"
                args="joint_state_broadcaster
                        -c /$(var robot_name)/controller_manager
                        --controller-manager-timeout 120.0
                        --switch-timeout 120.0
                        --service-call-timeout 30.0"/>

            <timer period="4.0">
            <node pkg="controller_manager" exec="spawner"
                    name="diffdrive_controller_spawner" output="screen"
                    args="diffdrive_controller 
                        -c /$(var robot_name)/controller_manager
                        --controller-manager-timeout 120.0
                        --switch-timeout 120.0
                        --service-call-timeout 30.0"/>
            </timer>
        </group>

        <!-- Twist Mux Node -->
        <node name="twist_mux" pkg="twist_mux" exec="twist_mux" output="screen">
            <param from="$(find-pkg-share husky_description)/params/twist_mux_$(var robot_name).yaml" />
            <remap from="keyboard"             to="wolf_controller/keyboard"/>
            <remap from="priority_twist"       to="wolf_controller/priority_twist"/>
            <remap from="twist"                to="wolf_controller/twist"/>
            <remap from="e_stop"               to="e_stop"/>
            <remap from="cmd_vel_out"          to="diffdrive_controller/cmd_vel_unstamped"/>
        </node>

        <!-- Jazzy diff_drive_controller subscribes to TwistStamped on
             diffdrive_controller/cmd_vel. Keep the existing Twist-based command
             sources and stamp only on the final hop into the controller. -->
        <node name="cmd_vel_stamper" pkg="twist_stamper" exec="twist_stamper" output="screen">
            <param name="frame_id" value=""/>
            <remap from="cmd_vel_in"  to="diffdrive_controller/cmd_vel_unstamped"/>
            <remap from="cmd_vel_out" to="diffdrive_controller/cmd_vel"/>
        </node>

        <group if="$(eval '\'$(var robot_name)\' == \'\'')">
            <node pkg="topic_tools" exec="relay" name="cmdvel_to_wolf" output="screen"
                args="/diffdrive_controller/cmd_vel_unstamped /wolf_controller/twist" />
        </group>
        <group if="$(eval '\'$(var robot_name)\' != \'\'')">
            <node pkg="topic_tools" exec="relay" name="$(var robot_name)_cmdvel_to_wolf" output="screen"
                args="/$(var robot_name)/diffdrive_controller/cmd_vel_unstamped /$(var robot_name)/wolf_controller/twist" />
        </group>

        <!-- Mirror the ROS1 Husky launch: navigation/localization expects the
             generic odometry/robot topic, while diff_drive_controller publishes
             on diffdrive_controller/odom. -->
        <group if="$(eval '\'$(var robot_name)\' == \'\'')">
            <node pkg="topic_tools" exec="relay" name="odom_to_robot" output="screen"
                args="/diffdrive_controller/odom /odometry/robot" />
        </group>
        <group if="$(eval '\'$(var robot_name)\' != \'\'')">
            <node pkg="topic_tools" exec="relay" name="$(var robot_name)_odom_to_robot" output="screen"
                args="/$(var robot_name)/diffdrive_controller/odom /$(var robot_name)/odometry/robot" />
        </group>

        <!-- Keyboard node -->
        <node name="keyboard_node" pkg="wolf_controller" exec="keyboard_node" respawn="true" output="screen">
            <param name="robot_name"               value="$(var robot_name)"/>
            <param name="max_linear_x"             value="$(var max_vel_x)"/>
            <param name="max_angular_z"            value="$(var max_vel_yaw)"/>
            <param name="stop_without_input"       value="true"/>
            <param name="emergency_stop_topic"     value="e_stop"/>
        </node>

        <!-- Base stabilizer node -->
        <node name="base_stabilizer" pkg="wolf_controller_utils" exec="base_stabilizer" respawn="true" output="screen">
            <param name="robot_name"         value="$(var robot_name)"/>
            <param name="imu_topic"          value="trunk_imu/data"/>
            <param name="base_frame"         value="base_link"/>
            <param name="parent_frame"       value="odom"/>
            <param name="stabilized_frame"   value="base_stabilized"/>
        </node>

        <!-- GUI nodes -->
        <!-- rviz -->
        <group if="$(eval ' \'$(var rviz_gui)\' ')">
            <node name="wolf_rviz" pkg="rviz2" exec="rviz2"
                args="-d $(find-pkg-share wolf_controller)/rviz/controller.rviz2.rviz"/>
        </group>
    
    </group>
    </timer>

</launch>
