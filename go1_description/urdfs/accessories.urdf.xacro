<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="simulator" default="ignition"/>

  <xacro:include filename="$(find sensors_description)/urdfs/common.xacro"/>
  <xacro:include filename="$(find sensors_description)/urdfs/sensors/depth_camera.gazebo.xacro"/>
  <xacro:include filename="$(find sensors_description)/urdfs/sensors/gps.gazebo.xacro"/>
  <xacro:include filename="$(find sensors_description)/urdfs/sensors/lidar.gazebo.xacro"/>


    <joint name="lidar_cage_to_lidar" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_mount"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
    </joint>
    <link name="lidar_mount">
        <inertial>
            <origin rpy="0.0 0.0 0.0" xyz="-0.012 0.001 -0.008"/>
            <mass value="0.695"/>
            <inertia ixx="0.000846765" ixy="6.9565e-05" ixz="0.00027111" iyy="0.001367583" iyz="5.8984e-05" izz="0.001363673"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="file://$(find go1_description)/meshes/lidar.dae"/>
          </geometry>
        </visual>
    </link>

    <joint name="base_link_to_camera" type="fixed">
        <parent link="base_link"/>
        <child link="camera_mount"/>
        <origin rpy="0 0.3 0" xyz="0.3 0 0.05"/>
    </joint>
    <link name="camera_mount">
        <inertial>
            <origin rpy="0 0.0 0" xyz="0.0 0 0.0"/>
            <mass value="0.001"/>
            <inertia ixx="0.000846765" ixy="6.9565e-05" ixz="0.00027111" iyy="0.001367583" iyz="5.8984e-05" izz="0.001363673"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="file://$(find go1_description)/meshes/depth_camera.dae"/>
          </geometry>
        </visual>
    </link>

  <xacro:depth_camera 
    name="camera"
    namespace="$(arg robot_name)" 
    update_rate="30"
    image_width="640"
    image_height="480"
    fov="1.047"
    near="0.1"
    far="10.0"
    parent_link="camera_mount"
    origin_xyz="0.0 0 0.0" 
    origin_rpy="0 0.0 0"/>

  <xacro:velodyne_laser_gazebo_sensor 
    sensor_name="$(arg robot_name)_lidar"
    topic_name="lidar_points" 
    update_rate="10.0" 
    frame_id="lidar_mount" 
    namespace="$(arg robot_name)" 
    min_range="0.9" 
    max_range="130.0" 
    number_of_beams="32" 
    horizontal_samples="220" 
    horizontal_fov="6.28319"      
    vertical_fov="0.2618"    
    noise_stddev="0.01"/>
    <!--<origin xyz="0.1 0 0" rpy="0 0 0" />-->

  <!-- GPS sensor -->
  <xacro:gazebo_gps_sensor 
    sensor_name="$(arg robot_name)_gps"
    namespace="$(arg robot_name)"
    gps_topic="gps/fix" 
    velocity_topic="gps/velocity_fix"
    update_rate="10.0" 
    frame_id="base_link" />

</robot>
